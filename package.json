{
  "name": "dsh-task-confirm",
  "version": "0.1.0",
  "description": "Two-phase task confirmation gate for DeepSeek Harness top-level sessions",
  "license": "MIT",
  "author": "czdtech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czdtech/dsh-task-confirm.git"
  },
  "homepage": "https://github.com/czdtech/dsh-task-confirm#readme",
  "bugs": {
    "url": "https://github.com/czdtech/dsh-task-confirm/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "task-confirmation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.20.6",
    "typescript": "^5.6.0"
  }
}
